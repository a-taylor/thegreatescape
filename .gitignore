/node_modules/
/.venv/
__pycache__/
*.py[cod]

# Build output
/dist/

# The original brief. Kept locally, deliberately not published -- see CLAUDE.md.
/BUILD_PROMPT.md

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# The generated asset viewer -- rebuild with `npm run assetviewer`.
